---
import Base from '../layouts/Base.astro';
import { getRegisteredGames, RATING_COLORS } from '../lib/games';

const games = getRegisteredGames();
const gameCount = games.length;
---

<Base title="CHESSWORLD.GAMES" description="Chess-inspired browser games built by the Zenith team.">
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-eyebrow">A Zenith Project</div>
        <h1 class="hero-title">CHESSWORLD<span class="dot">.</span>GAMES</h1>
        <p class="hero-sub">
          Browser games built by developers who think in systems.<br />
          Chess-inspired. Community-driven. Open to contributors.
        </p>
        <div class="hero-actions">
          <a href="/games" class="btn btn-primary">Browse Games</a>
          <a href="/docs" class="btn btn-outline">Start Building</a>
        </div>
        <div class="hero-stat">
          <span class="stat-num">{gameCount}</span>
          <span class="stat-label">{gameCount === 1 ? 'game' : 'games'} available</span>
        </div>
      </div>
    </div>
    <div class="hero-board" aria-hidden="true">
      {Array.from({ length: 64 }).map((_, i) => (
        <div class:list={['cell', { light: (Math.floor(i / 8) + i) % 2 === 0 }]} />
      ))}
    </div>
  </section>

  <section class="features">
    <div class="container">
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">♟</div>
          <h3>Chess-Inspired</h3>
          <p>Every game on this platform draws from chess in some way — strategy, structure, rules, or aesthetics.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">⚡</div>
          <h3>Developer Freedom</h3>
          <p>Use any stack you want. React, Svelte, vanilla JS, canvas — if it runs in a browser, it belongs here.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🔒</div>
          <h3>Curated Quality</h3>
          <p>Every game is reviewed before going live. We're not just looking for polish — we're looking for how you think.</p>
        </div>
      </div>
    </div>
  </section>

  {gameCount > 0 && (
    <section class="preview">
      <div class="container">
        <h2 class="section-title">LATEST GAMES</h2>
        <div class="games-preview">
          {games.slice(0, 3).map(game => (
            <a href={`/games/${game.id}`} class="game-card">
              <div class="game-thumb">
                <img src={`/games/${game.id}/${game.thumbnail}`} alt={game.title} loading="lazy" />
              </div>
              <div class="game-info">
                <h3>{game.title}</h3>
                <p>{game.description}</p>
                <div class="game-tags">
                  {game.tags.map(tag => <span class="tag">{tag}</span>)}
                </div>
              </div>
            </a>
          ))}
        </div>
        <div class="preview-cta">
          <a href="/games" class="btn btn-outline">View All Games →</a>
        </div>
      </div>
    </section>
  )}
</Base>

<style>
.hero {
  position: relative;
  min-height: calc(100vh - var(--nav-height));
  display: flex;
  align-items: center;
  overflow: hidden;
}

.hero-inner {
  position: relative;
  z-index: 2;
  padding: 5rem 0;
}

.hero-eyebrow {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--color-secondary);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: 1rem;
}

.hero-title {
  font-size: clamp(4rem, 12vw, 9rem);
  color: var(--color-text-primary);
  line-height: 1;
  margin-bottom: 1.5rem;
}

.dot {
  color: var(--color-accent);
}

.hero-sub {
  font-size: clamp(1rem, 2vw, 1.2rem);
  color: var(--color-text-secondary);
  max-width: 520px;
  line-height: 1.7;
  margin-bottom: 2.5rem;
}

.hero-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 3rem;
}

.hero-stat {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
}

.stat-num {
  font-family: var(--font-display);
  font-size: 2.5rem;
  color: var(--color-accent);
  line-height: 1;
}

.stat-label {
  font-size: 0.9rem;
  color: var(--color-border);
}

.hero-board {
  position: absolute;
  right: -5%;
  top: 50%;
  transform: translateY(-50%) rotate(12deg);
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  width: min(50vw, 480px);
  aspect-ratio: 1;
  opacity: 0.06;
  pointer-events: none;
}

.cell {
  background: var(--color-bg-surface);
}
.cell.light {
  background: var(--color-text-primary);
}

.features {
  padding: 5rem 0;
  border-top: 1px solid rgba(119, 141, 169, 0.15);
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.5rem;
}

.feature-card {
  background: rgba(65, 90, 119, 0.25);
  border: 1px solid rgba(119, 141, 169, 0.2);
  border-radius: 12px;
  padding: 2rem;
  transition: border-color 0.2s, transform 0.2s;
}

.feature-card:hover {
  border-color: rgba(58, 134, 255, 0.3);
  transform: translateY(-2px);
}

.feature-icon {
  font-size: 2rem;
  margin-bottom: 1rem;
  line-height: 1;
}

.feature-card h3 {
  font-size: 1.3rem;
  color: var(--color-text-primary);
  margin-bottom: 0.75rem;
}

.feature-card p {
  color: var(--color-text-secondary);
  font-size: 0.95rem;
  line-height: 1.6;
}

.preview {
  padding: 4rem 0;
  border-top: 1px solid rgba(119, 141, 169, 0.15);
}

.section-title {
  font-size: 2rem;
  color: var(--color-text-primary);
  margin-bottom: 2rem;
  letter-spacing: 0.08em;
}

.games-preview {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.game-card {
  background: rgba(65, 90, 119, 0.2);
  border: 1px solid rgba(119, 141, 169, 0.2);
  border-radius: 12px;
  overflow: hidden;
  text-decoration: none;
  transition: all 0.2s;
  display: block;
}

.game-card:hover {
  border-color: rgba(58, 134, 255, 0.4);
  transform: translateY(-3px);
}

.game-thumb {
  aspect-ratio: 16/9;
  background: rgba(65, 90, 119, 0.4);
  overflow: hidden;
}

.game-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.game-info {
  padding: 1.25rem;
}

.game-info h3 {
  font-size: 1.2rem;
  color: var(--color-text-primary);
  margin-bottom: 0.4rem;
}

.game-info p {
  font-size: 0.875rem;
  color: var(--color-text-secondary);
  margin-bottom: 0.75rem;
  line-height: 1.5;
}

.game-tags {
  display: flex;
  gap: 0.4rem;
  flex-wrap: wrap;
}

.preview-cta {
  text-align: center;
  margin-top: 1rem;
}
</style>
