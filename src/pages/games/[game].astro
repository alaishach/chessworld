---
import Base from '../../layouts/Base.astro';
import { getGameContent, RATING_LABELS, RATING_COLORS } from '../../lib/games';
import { renderMarkdown } from '../../lib/markdown';

const { game: gameId } = Astro.params;
const content = gameId ? getGameContent(gameId) : null;

if (!content) {
  return Astro.redirect('/games');
}

const { manifest: game, description, rules } = content;
const gameEntryUrl = `/games/${game.id}/${game.entry}`;
const ratingColor = RATING_COLORS[game.rating];
const ratingLabel = RATING_LABELS[game.rating];
const githubUrl = `https://github.com/${game.author}`;

const descriptionHtml = description ? renderMarkdown(description) : null;
const rulesHtml = rules ? renderMarkdown(rules) : null;

function formatDate(dateStr: string): string {
  const [year, month, day] = dateStr.split('-').map(Number);
  const date = new Date(year, month - 1, day);
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const sortedChangelog = [...(game.changelog ?? [])].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<Base title={game.title} description={game.description}>
  <div class="game-page">

    <!-- Back navigation -->
    <div class="back-nav container">
      <a href="/" class="back-link">← Home</a>
      <a href="/games" class="back-link">← Game Listing</a>
    </div>

    <!-- Game header -->
    <div class="game-header container">
      <div class="game-header-top">
        <h1 class="game-title">{game.title}</h1>
        <div class="game-meta-row">
          <a href={githubUrl} target="_blank" rel="noopener" class="author-link">
            by {game.author} ↗
          </a>
          <span
            class="rating-badge"
            style={`background:${ratingColor.bg};color:${ratingColor.text};border-color:${ratingColor.text}30`}
          >
            {game.rating} — {ratingLabel}
          </span>
          <span class="version-badge">v{game.version}</span>
        </div>
        <div class="game-tags-row">
          {game.tags.map(tag => <span class="tag">{tag}</span>)}
          {game.chessRelation && (
            <span class="chess-tag">♟ {game.chessRelation}</span>
          )}
        </div>
      </div>
    </div>

    <!-- Iframe fills the middle -->
    <div class="game-frame-wrap">
      <iframe
        src={gameEntryUrl}
        title={game.title}
        class="game-frame"
        allow="fullscreen"
        sandbox="allow-scripts allow-same-origin allow-forms"
      ></iframe>
    </div>

    <!-- Description above rules/changelog -->
    <div class="game-content container">

      <section class="description-section">
        {descriptionHtml ? (
          <div class="md-body" set:html={descriptionHtml} />
        ) : (
          <p class="no-content">No description provided.</p>
        )}
      </section>

      <div class="content-lower">
        <section class="rules-section">
          <h2 class="section-label">Rules &amp; Controls</h2>
          {rulesHtml ? (
            <div class="md-body" set:html={rulesHtml} />
          ) : (
            <p class="no-content">No rules provided.</p>
          )}
        </section>

        <section class="changelog-section">
          <h2 class="section-label">Changelog</h2>
          {sortedChangelog.length > 0 ? (
            <div class="changelog">
              {sortedChangelog.map((entry, i) => (
                <div class:list={['changelog-entry', { latest: i === 0 }]}>
                  <div class="changelog-header">
                    <span class="changelog-version">v{entry.version}</span>
                    {i === 0 && <span class="latest-badge">Latest</span>}
                    <span class="changelog-date">{formatDate(entry.date)}</span>
                  </div>
                  <p class="changelog-notes">{entry.notes}</p>
                </div>
              ))}
            </div>
          ) : (
            <p class="no-content">No changelog entries.</p>
          )}
        </section>
      </div>

    </div>
  </div>
</Base>

<style>
.game-page {
  min-height: calc(100vh - var(--nav-height));
  display: flex;
  flex-direction: column;
}

.back-nav {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  padding-top: 1.25rem;
  padding-bottom: 0.75rem;
}

.back-link {
  font-size: 0.8rem;
  color: var(--color-border);
  text-decoration: none;
  transition: color 0.2s;
  width: fit-content;
}
.back-link:hover { color: var(--color-primary); }

.game-header {
  padding-bottom: 1.25rem;
  border-bottom: 1px solid rgba(119,141,169,0.15);
}

.game-title {
  font-size: clamp(2rem, 5vw, 3.5rem);
  color: var(--color-text-primary);
  margin-bottom: 0.6rem;
}

.game-meta-row {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin-bottom: 0.75rem;
}

.author-link {
  font-size: 0.875rem;
  color: var(--color-secondary);
  text-decoration: none;
  transition: color 0.2s;
}
.author-link:hover { color: var(--color-hover); }

.rating-badge {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 600;
  padding: 0.2rem 0.6rem;
  border-radius: 4px;
  border: 1px solid;
  letter-spacing: 0.04em;
}

.version-badge {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--color-border);
  padding: 0.2rem 0.5rem;
  border: 1px solid rgba(119,141,169,0.2);
  border-radius: 4px;
}

.game-tags-row {
  display: flex;
  gap: 0.4rem;
  flex-wrap: wrap;
}

.chess-tag {
  display: inline-block;
  padding: 0.2rem 0.6rem;
  border-radius: 4px;
  font-size: 0.75rem;
  font-style: italic;
  color: var(--color-secondary);
  background: rgba(46,196,182,0.08);
  border: 1px solid rgba(46,196,182,0.15);
}

.game-frame-wrap {
  width: 100%;
  background: #000;
  border-top: 1px solid rgba(119,141,169,0.12);
  border-bottom: 1px solid rgba(119,141,169,0.12);
}

.game-frame {
  display: block;
  width: 100%;
  height: calc(100vh - var(--nav-height) - 240px);
  min-height: 480px;
  max-height: 900px;
  border: none;
}

.game-content {
  padding-top: 2.5rem;
  padding-bottom: 5rem;
}

.description-section {
  padding-bottom: 2rem;
  border-bottom: 1px solid rgba(119,141,169,0.15);
  margin-bottom: 2.5rem;
}

.content-lower {
  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 3rem;
  align-items: start;
}

.section-label {
  font-size: 0.85rem;
  letter-spacing: 0.1em;
  color: var(--color-border);
  text-transform: uppercase;
  margin-bottom: 1.25rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid rgba(119,141,169,0.15);
}

/* Markdown */
.md-body {
  color: var(--color-text-secondary);
  font-size: 0.95rem;
  line-height: 1.75;
}
.md-body :global(h1) { font-size: 1.5rem; color: var(--color-text-primary); margin: 0 0 0.75rem; }
.md-body :global(h2) { font-size: 1.1rem; color: var(--color-text-primary); margin: 1.5rem 0 0.6rem; }
.md-body :global(h3) { font-size: 0.95rem; color: var(--color-text-secondary); margin: 1.25rem 0 0.5rem; }
.md-body :global(p) { margin: 0 0 0.9rem; }
.md-body :global(ul), .md-body :global(ol) { padding-left: 1.4rem; margin: 0 0 0.9rem; }
.md-body :global(li) { margin-bottom: 0.35rem; }
.md-body :global(strong) { color: var(--color-text-primary); font-weight: 600; }
.md-body :global(em) { font-style: italic; }
.md-body :global(code) {
  font-family: var(--font-mono);
  font-size: 0.85em;
  background: rgba(58,134,255,0.1);
  color: var(--color-secondary);
  padding: 0.1em 0.35em;
  border-radius: 3px;
}
.md-body :global(table) { width: 100%; border-collapse: collapse; font-size: 0.875rem; margin: 1rem 0; }
.md-body :global(th) {
  text-align: left;
  padding: 0.5rem 0.75rem;
  border-bottom: 1px solid rgba(119,141,169,0.3);
  color: var(--color-text-primary);
  font-weight: 600;
  background: rgba(65,90,119,0.2);
}
.md-body :global(td) {
  padding: 0.45rem 0.75rem;
  border-bottom: 1px solid rgba(119,141,169,0.1);
  color: var(--color-text-secondary);
}
.md-body :global(hr) { border: none; border-top: 1px solid rgba(119,141,169,0.2); margin: 1.5rem 0; }

/* Changelog */
.changelog { display: flex; flex-direction: column; gap: 0.75rem; }

.changelog-entry {
  padding: 0.9rem 1rem;
  border-radius: 8px;
  background: rgba(65,90,119,0.15);
  border: 1px solid rgba(119,141,169,0.15);
}
.changelog-entry.latest {
  border-color: rgba(58,134,255,0.25);
  background: rgba(58,134,255,0.06);
}

.changelog-header {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 0.4rem;
  flex-wrap: wrap;
}

.changelog-version {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--color-text-primary);
}

.latest-badge {
  font-size: 0.65rem;
  font-family: var(--font-mono);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 0.15rem 0.45rem;
  border-radius: 3px;
  background: rgba(58,134,255,0.15);
  color: var(--color-primary);
  border: 1px solid rgba(58,134,255,0.2);
}

.changelog-date {
  font-size: 0.75rem;
  color: var(--color-border);
  margin-left: auto;
}

.changelog-notes {
  font-size: 0.875rem;
  color: var(--color-text-secondary);
  line-height: 1.5;
  margin: 0;
}

.no-content {
  color: var(--color-border);
  font-size: 0.875rem;
  font-style: italic;
}

@media (max-width: 900px) {
  .content-lower { grid-template-columns: 1fr; gap: 2rem; }
  .game-frame { height: 55vw; min-height: 320px; }
}
@media (max-width: 640px) {
  .game-frame { height: 70vw; min-height: 280px; }
}
</style>
