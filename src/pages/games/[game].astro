---
import Base from '../../layouts/Base.astro';
import { getGameContent, RATING_LABELS, RATING_COLORS } from '../../lib/games';
import { renderMarkdown } from '../../lib/markdown';

const { game: gameId } = Astro.params;

if (gameId && gameId.includes('.')) {
  return new Response(null, { status: 404 });
}

const content = gameId ? getGameContent(gameId) : null;

if (!content) {
  return Astro.redirect('/games');
}

const { manifest: game, description, rules } = content;
const gameEntryUrl = `/games/${game.id}/${game.entry}`;
const ratingColor = RATING_COLORS[game.rating];
const ratingLabel = RATING_LABELS[game.rating];
const githubUrl = `https://github.com/${game.author}`;

const descriptionHtml = description ? renderMarkdown(description) : null;
const rulesHtml = rules ? renderMarkdown(rules) : null;

function formatDate(dateStr: string): string {
  const [year, month, day] = dateStr.split('-').map(Number);
  const date = new Date(year, month - 1, day);
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const sortedChangelog = [...(game.changelog ?? [])].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<Base title={game.title} description={game.description}>
  <div class="game-page">

    <!-- Back navigation -->
    <div class="back-nav container">
      <a href="/" class="back-link">← Home</a>
      <a href="/games" class="back-link">← All Games</a>
    </div>

    <!-- Sticky game header -->
    <div class="game-header-wrap">
      <div class="game-header container">
        <div class="game-header-left">
          <h1 class="game-title">{game.title}</h1>
          <div class="game-meta-row">
            <a href={githubUrl} target="_blank" rel="noopener" class="author-link">
              by {game.author} ↗
            </a>
            <span
              class="rating-badge"
              style={`background:${ratingColor.bg};color:${ratingColor.text};border-color:${ratingColor.text}30`}
            >
              {game.rating} — {ratingLabel}
            </span>
            <span class="version-badge">v{game.version}</span>
          </div>
          <div class="game-tags-row">
            {game.tags.map(tag => <span class="tag">{tag}</span>)}
            {game.chessRelation && (
              <span class="chess-tag">♟ {game.chessRelation}</span>
            )}
          </div>
        </div>
        <div class="game-header-right">
          {descriptionHtml ? (
            <div class="header-description md-body" set:html={descriptionHtml} />
          ) : (
            <p class="no-content">No description provided.</p>
          )}
        </div>
      </div>
    </div>

    <!-- Game iframe -->
    <div class="game-frame-wrap">
      <iframe
        src={gameEntryUrl}
        title={game.title}
        class="game-frame"
        allow="fullscreen"
        sandbox="allow-scripts allow-same-origin allow-forms"
      ></iframe>
    </div>

    <!-- Rules & Changelog -->
    <div class="game-content container">
      <div class="content-lower">

        <section class="rules-section">
          <button class="rules-toggle" id="rulesToggle" aria-expanded="false">
            Rules &amp; Controls
            <span class="toggle-icon">▼</span>
          </button>
          <div class="rules-body" id="rulesBody">
            {rulesHtml ? (
              <div class="md-body" set:html={rulesHtml} />
            ) : (
              <p class="no-content">No rules provided.</p>
            )}
          </div>
        </section>

        <section class="changelog-section">
          <h2 class="section-label">Changelog</h2>
          {sortedChangelog.length > 0 ? (
            <div class="changelog">
              {sortedChangelog.map((entry, i) => (
                <div class:list={['changelog-entry', { latest: i === 0 }]}>
                  <div class="changelog-header">
                    <span class="changelog-version">v{entry.version}</span>
                    {i === 0 && <span class="latest-badge">Latest</span>}
                    <span class="changelog-date">{formatDate(entry.date)}</span>
                  </div>
                  <p class="changelog-notes">{entry.notes}</p>
                </div>
              ))}
            </div>
          ) : (
            <p class="no-content">No changelog entries.</p>
          )}
        </section>

      </div>
    </div>
  </div>
</Base>

<style>
.game-page {
  min-height: calc(100vh - var(--nav-height));
  display: flex;
  flex-direction: column;
}

.back-nav {
  display: flex;
  gap: 1rem;
  padding-top: 0.75rem;
  padding-bottom: 0.5rem;
}

.back-link {
  font-size: 0.8rem;
  color: var(--color-border);
  text-decoration: none;
  transition: color 0.2s;
}
.back-link:hover { color: var(--color-primary); }

/* Sticky header */
.game-header-wrap {
  position: sticky;
  top: var(--nav-height);
  z-index: 90;
  background: rgba(18, 17, 42, 0.96);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(108, 99, 255, 0.15);
}

.game-header {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 2rem;
  align-items: start;
  padding-top: 0.75rem;
  padding-bottom: 0.75rem;
}

.game-header-left {
  min-width: 0;
}

.game-title {
  font-size: clamp(1.5rem, 3vw, 2.25rem);
  color: var(--color-text-primary);
  margin-bottom: 0.35rem;
  white-space: nowrap;
}

.game-meta-row {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex-wrap: wrap;
  margin-bottom: 0.4rem;
}

.author-link {
  font-size: 0.8rem;
  color: var(--color-secondary);
  text-decoration: none;
  transition: color 0.2s;
}
.author-link:hover { color: var(--color-hover); }

.rating-badge {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 600;
  padding: 0.15rem 0.5rem;
  border-radius: 4px;
  border: 1px solid;
  letter-spacing: 0.04em;
}

.version-badge {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--color-border);
  padding: 0.15rem 0.4rem;
  border: 1px solid rgba(108, 99, 255, 0.2);
  border-radius: 4px;
}

.game-tags-row {
  display: flex;
  gap: 0.35rem;
  flex-wrap: wrap;
}

.chess-tag {
  display: inline-block;
  padding: 0.15rem 0.5rem;
  border-radius: 4px;
  font-size: 0.72rem;
  font-style: italic;
  color: var(--color-secondary);
  background: rgba(108, 99, 255, 0.08);
  border: 1px solid rgba(108, 99, 255, 0.15);
}

.game-header-right {
  padding-top: 0.1rem;
  border-left: 1px solid rgba(108, 99, 255, 0.15);
  padding-left: 2rem;
}

.header-description {
  font-size: 0.875rem;
  line-height: 1.6;
  color: var(--color-text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* iframe */
.game-frame-wrap {
  width: 100%;
  background: #000;
  border-bottom: 1px solid rgba(108, 99, 255, 0.12);
  flex: 1;
}

.game-frame {
  display: block;
  width: 100%;
  height: calc(100vh - var(--nav-height) - 120px);
  min-height: 420px;
  max-height: 900px;
  border: none;
}

/* Content below */
.game-content {
  padding-top: 2rem;
  padding-bottom: 5rem;
}

.content-lower {
  display: grid;
  grid-template-columns: 1fr 320px;
  gap: 3rem;
  align-items: start;
}

.section-label {
  font-size: 0.8rem;
  letter-spacing: 0.1em;
  color: var(--color-border);
  text-transform: uppercase;
  margin-bottom: 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid rgba(108, 99, 255, 0.15);
}

/* Rules toggle */
.rules-toggle {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: none;
  border: none;
  border-bottom: 1px solid rgba(108, 99, 255, 0.15);
  padding: 0 0 0.5rem;
  font-size: 0.8rem;
  letter-spacing: 0.1em;
  color: var(--color-border);
  text-transform: uppercase;
  cursor: pointer;
  margin-bottom: 0;
  transition: color 0.2s;
}
.rules-toggle:hover { color: var(--color-primary); }
.rules-toggle[aria-expanded="true"] .toggle-icon { transform: rotate(180deg); }

.toggle-icon {
  font-size: 0.65rem;
  transition: transform 0.2s;
}

.rules-body {
  display: none;
  padding-top: 1rem;
}
.rules-body.open { display: block; }

/* Markdown */
.md-body {
  color: var(--color-text-secondary);
  font-size: 0.95rem;
  line-height: 1.75;
}
.md-body :global(h1) { font-size: 1.4rem; color: var(--color-text-primary); margin: 0 0 0.75rem; }
.md-body :global(h2) { font-size: 1.05rem; color: var(--color-text-primary); margin: 1.25rem 0 0.5rem; }
.md-body :global(h3) { font-size: 0.95rem; color: var(--color-text-secondary); margin: 1rem 0 0.4rem; }
.md-body :global(p) { margin: 0 0 0.9rem; }
.md-body :global(ul), .md-body :global(ol) { padding-left: 1.4rem; margin: 0 0 0.9rem; }
.md-body :global(li) { margin-bottom: 0.35rem; }
.md-body :global(strong) { color: var(--color-text-primary); font-weight: 600; }
.md-body :global(code) {
  font-family: var(--font-mono);
  font-size: 0.85em;
  background: rgba(108, 99, 255, 0.1);
  color: var(--color-secondary);
  padding: 0.1em 0.35em;
  border-radius: 3px;
}
.md-body :global(table) { width: 100%; border-collapse: collapse; font-size: 0.875rem; margin: 1rem 0; }
.md-body :global(th) {
  text-align: left;
  padding: 0.5rem 0.75rem;
  border-bottom: 1px solid rgba(108, 99, 255, 0.3);
  color: var(--color-text-primary);
  font-weight: 600;
  background: rgba(108, 99, 255, 0.1);
}
.md-body :global(td) {
  padding: 0.45rem 0.75rem;
  border-bottom: 1px solid rgba(108, 99, 255, 0.1);
  color: var(--color-text-secondary);
}
.md-body :global(hr) { border: none; border-top: 1px solid rgba(108, 99, 255, 0.2); margin: 1.5rem 0; }

/* Changelog */
.changelog { display: flex; flex-direction: column; gap: 0.75rem; }

.changelog-entry {
  padding: 0.9rem 1rem;
  border-radius: 8px;
  background: rgba(108, 99, 255, 0.06);
  border: 1px solid rgba(108, 99, 255, 0.12);
}
.changelog-entry.latest {
  border-color: rgba(108, 99, 255, 0.3);
  background: rgba(108, 99, 255, 0.1);
}

.changelog-header {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 0.4rem;
  flex-wrap: wrap;
}

.changelog-version {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--color-text-primary);
}

.latest-badge {
  font-size: 0.65rem;
  font-family: var(--font-mono);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 0.15rem 0.45rem;
  border-radius: 3px;
  background: rgba(108, 99, 255, 0.2);
  color: var(--color-primary);
  border: 1px solid rgba(108, 99, 255, 0.3);
}

.changelog-date {
  font-size: 0.75rem;
  color: var(--color-border);
  margin-left: auto;
}

.changelog-notes {
  font-size: 0.875rem;
  color: var(--color-text-secondary);
  line-height: 1.5;
  margin: 0;
}

.no-content {
  color: var(--color-border);
  font-size: 0.875rem;
  font-style: italic;
}

@media (max-width: 900px) {
  .game-header { grid-template-columns: 1fr; gap: 0.75rem; }
  .game-header-right { border-left: none; padding-left: 0; border-top: 1px solid rgba(108,99,255,0.15); padding-top: 0.75rem; }
  .content-lower { grid-template-columns: 1fr; gap: 2rem; }
  .game-frame { height: 55vw; min-height: 300px; }
}
@media (max-width: 640px) {
  .game-title { white-space: normal; }
  .game-frame { height: 70vw; min-height: 260px; }
}
</style>

<script>
const toggle = document.getElementById('rulesToggle');
const body = document.getElementById('rulesBody');
toggle?.addEventListener('click', () => {
  const expanded = toggle.getAttribute('aria-expanded') === 'true';
  toggle.setAttribute('aria-expanded', String(!expanded));
  body?.classList.toggle('open', !expanded);
});
</script>
