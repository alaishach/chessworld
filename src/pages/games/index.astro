---
import Base from '../../layouts/Base.astro';
import { getRegisteredGames, RATING_LABELS, RATING_COLORS } from '../../lib/games';

const games = getRegisteredGames();
---

<Base title="Games" description="All chess-inspired browser games on CHESSWORLD.GAMES">
  <div class="container">
    <div class="page-header">
      <h1>GAMES</h1>
      <p>Chess-inspired browser games built by the Zenith team.</p>
    </div>

    {games.length === 0 ? (
      <div class="empty-state">
        <div class="empty-icon">♟</div>
        <h2>No games yet</h2>
        <p>The board is set. Waiting for the first move.</p>
        <a href="/docs" class="btn btn-primary" style="margin-top:1.5rem">Read the Docs →</a>
      </div>
    ) : (
      <div class="games-grid">
        {games.map(game => (
          <a href={`/games/${game.id}`} class="game-card">
            <div class="game-thumb">
              <img src={`/games/${game.id}/${game.thumbnail}`} alt={game.title} loading="lazy" />
              <div class="game-overlay">
                <span class="play-btn">▶ Play</span>
              </div>
            </div>
            <div class="game-info">
              <div class="game-header">
                <h3>{game.title}</h3>
                <div class="game-header-right">
                  <span
                    class="rating-badge"
                    style={`background:${RATING_COLORS[game.rating].bg};color:${RATING_COLORS[game.rating].text};border-color:${RATING_COLORS[game.rating].text}30`}
                  >
                    {game.rating}
                  </span>
                  <span class="game-version">v{game.version}</span>
                </div>
              </div>
              <p class="game-desc">{game.description}</p>
              {game.chessRelation && (
                <p class="chess-relation">♟ {game.chessRelation}</p>
              )}
              <div class="game-footer">
                <div class="game-tags">
                  {game.tags.map(tag => <span class="tag">{tag}</span>)}
                </div>
                <span class="game-author">by {game.author}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Base>

<style>
.games-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1.5rem;
  padding-bottom: 4rem;
}

.game-card {
  display: block;
  background: rgba(65, 90, 119, 0.2);
  border: 1px solid rgba(119, 141, 169, 0.2);
  border-radius: 12px;
  overflow: hidden;
  text-decoration: none;
  transition: all 0.25s ease;
}

.game-card:hover {
  border-color: rgba(58, 134, 255, 0.4);
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

.game-thumb {
  position: relative;
  aspect-ratio: 16/9;
  background: rgba(65, 90, 119, 0.5);
  overflow: hidden;
}

.game-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.game-card:hover .game-thumb img {
  transform: scale(1.04);
}

.game-overlay {
  position: absolute;
  inset: 0;
  background: rgba(27, 38, 59, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.2s;
}

.game-card:hover .game-overlay {
  opacity: 1;
}

.play-btn {
  background: var(--color-primary);
  color: white;
  padding: 0.6rem 1.5rem;
  border-radius: 6px;
  font-weight: 600;
  font-size: 0.95rem;
  letter-spacing: 0.02em;
}

.game-info {
  padding: 1.25rem;
}

.game-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.5rem;
  margin-bottom: 0.5rem;
}

.game-header-right {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  flex-shrink: 0;
}

.rating-badge {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 600;
  padding: 0.15rem 0.45rem;
  border-radius: 3px;
  border: 1px solid;
  letter-spacing: 0.04em;
}

.game-header h3 {
  font-size: 1.2rem;
  color: var(--color-text-primary);
}

.game-version {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--color-border);
}

.game-desc {
  font-size: 0.875rem;
  color: var(--color-text-secondary);
  line-height: 1.55;
  margin-bottom: 0.6rem;
}

.chess-relation {
  font-size: 0.8rem;
  color: var(--color-secondary);
  margin-bottom: 0.75rem;
  font-style: italic;
}

.game-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.game-tags {
  display: flex;
  gap: 0.35rem;
  flex-wrap: wrap;
}

.game-author {
  font-size: 0.75rem;
  color: var(--color-border);
  font-family: var(--font-mono);
  flex-shrink: 0;
}

.empty-state {
  text-align: center;
  padding: 6rem 2rem;
}

.empty-icon {
  font-size: 4rem;
  margin-bottom: 1.5rem;
  opacity: 0.3;
}

.empty-state h2 {
  font-size: 2rem;
  color: var(--color-text-primary);
  margin-bottom: 0.75rem;
}

.empty-state p {
  color: var(--color-text-secondary);
}
</style>
