---
import Base from '../layouts/Base.astro';
---

<Base title="404" description="Page not found">
  <div class="placeholder-page">
    <div class="inner">
      <h1>404</h1>
      <div class="placeholder-accent"></div>
      <p>This square is empty. The page you're looking for doesn't exist.</p>
      <a href="/" class="btn btn-outline" style="margin-top:1.5rem">← Back to Home</a>
    </div>
  </div>
</Base>
