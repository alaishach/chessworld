<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 180">
  <rect width="320" height="180" fill="#1B263B"/>
  <!-- Board squares -->
  <g>
    <!-- Row 0 (top - black pawns) -->
    <rect x="60" y="20" width="30" height="30" fill="#e8d5b0"/>
    <rect x="90" y="20" width="30" height="30" fill="#8b6340"/>
    <rect x="120" y="20" width="30" height="30" fill="#e8d5b0"/>
    <rect x="150" y="20" width="30" height="30" fill="#8b6340"/>
    <rect x="180" y="20" width="30" height="30" fill="#e8d5b0"/>
    <rect x="210" y="20" width="30" height="30" fill="#8b6340"/>
    <!-- Row 1 -->
    <rect x="60" y="50" width="30" height="30" fill="#8b6340"/>
    <rect x="90" y="50" width="30" height="30" fill="#e8d5b0"/>
    <rect x="120" y="50" width="30" height="30" fill="#8b6340"/>
    <rect x="150" y="50" width="30" height="30" fill="#e8d5b0"/>
    <rect x="180" y="50" width="30" height="30" fill="#8b6340"/>
    <rect x="210" y="50" width="30" height="30" fill="#e8d5b0"/>
    <!-- Row 2 -->
    <rect x="60" y="80" width="30" height="30" fill="#e8d5b0"/>
    <rect x="90" y="80" width="30" height="30" fill="#8b6340"/>
    <rect x="120" y="80" width="30" height="30" fill="#e8d5b0"/>
    <rect x="150" y="80" width="30" height="30" fill="#8b6340"/>
    <rect x="180" y="80" width="30" height="30" fill="#e8d5b0"/>
    <rect x="210" y="80" width="30" height="30" fill="#8b6340"/>
    <!-- Row 3 -->
    <rect x="60" y="110" width="30" height="30" fill="#8b6340"/>
    <rect x="90" y="110" width="30" height="30" fill="#e8d5b0"/>
    <rect x="120" y="110" width="30" height="30" fill="#8b6340"/>
    <rect x="150" y="110" width="30" height="30" fill="#e8d5b0"/>
    <rect x="180" y="110" width="30" height="30" fill="#8b6340"/>
    <rect x="210" y="110" width="30" height="30" fill="#e8d5b0"/>
    <!-- Row 4 -->
    <rect x="60" y="140" width="30" height="30" fill="#e8d5b0"/>
    <rect x="90" y="140" width="30" height="30" fill="#8b6340"/>
    <rect x="120" y="140" width="30" height="30" fill="#e8d5b0"/>
    <rect x="150" y="140" width="30" height="30" fill="#8b6340"/>
    <rect x="180" y="140" width="30" height="30" fill="#e8d5b0"/>
    <rect x="210" y="140" width="30" height="30" fill="#8b6340"/>
    <!-- Row 5 (bottom - white pawns) -->
    <rect x="60" y="170" width="30" height="10" fill="#8b6340"/>
    <rect x="90" y="170" width="30" height="10" fill="#e8d5b0"/>
    <rect x="120" y="170" width="30" height="10" fill="#8b6340"/>
    <rect x="150" y="170" width="30" height="10" fill="#e8d5b0"/>
    <rect x="180" y="170" width="30" height="10" fill="#8b6340"/>
    <rect x="210" y="170" width="30" height="10" fill="#e8d5b0"/>
  </g>
  <!-- Black pawns row 0 -->
  <g fill="#1a1a2e" stroke="#555" stroke-width="1.5">
    <circle cx="75" cy="28" r="6"/><rect x="71" y="33" width="8" height="4" rx="1"/><ellipse cx="75" cy="44" rx="9" ry="7"/><rect x="66" y="49" width="18" height="4" rx="2"/>
    <circle cx="105" cy="28" r="6"/><rect x="101" y="33" width="8" height="4" rx="1"/><ellipse cx="105" cy="44" rx="9" ry="7"/><rect x="96" y="49" width="18" height="4" rx="2"/>
    <circle cx="135" cy="28" r="6"/><rect x="131" y="33" width="8" height="4" rx="1"/><ellipse cx="135" cy="44" rx="9" ry="7"/><rect x="126" y="49" width="18" height="4" rx="2"/>
    <circle cx="165" cy="28" r="6"/><rect x="161" y="33" width="8" height="4" rx="1"/><ellipse cx="165" cy="44" rx="9" ry="7"/><rect x="156" y="49" width="18" height="4" rx="2"/>
    <circle cx="195" cy="28" r="6"/><rect x="191" y="33" width="8" height="4" rx="1"/><ellipse cx="195" cy="44" rx="9" ry="7"/><rect x="186" y="49" width="18" height="4" rx="2"/>
    <circle cx="225" cy="28" r="6"/><rect x="221" y="33" width="8" height="4" rx="1"/><ellipse cx="225" cy="44" rx="9" ry="7"/><rect x="216" y="49" width="18" height="4" rx="2"/>
  </g>
  <!-- White pawns row 5 -->
  <g fill="#F8F9FA" stroke="#aaa" stroke-width="1.5">
    <circle cx="75" cy="148" r="6"/><rect x="71" y="153" width="8" height="4" rx="1"/><ellipse cx="75" cy="164" rx="9" ry="7"/><rect x="66" y="169" width="18" height="4" rx="2"/>
    <circle cx="105" cy="148" r="6"/><rect x="101" y="153" width="8" height="4" rx="1"/><ellipse cx="105" cy="164" rx="9" ry="7"/><rect x="96" y="169" width="18" height="4" rx="2"/>
    <circle cx="135" cy="148" r="6"/><rect x="131" y="153" width="8" height="4" rx="1"/><ellipse cx="135" cy="164" rx="9" ry="7"/><rect x="126" y="169" width="18" height="4" rx="2"/>
    <circle cx="165" cy="148" r="6"/><rect x="161" y="153" width="8" height="4" rx="1"/><ellipse cx="165" cy="164" rx="9" ry="7"/><rect x="156" y="169" width="18" height="4" rx="2"/>
    <circle cx="195" cy="148" r="6"/><rect x="191" y="153" width="8" height="4" rx="1"/><ellipse cx="195" cy="164" rx="9" ry="7"/><rect x="186" y="169" width="18" height="4" rx="2"/>
    <circle cx="225" cy="148" r="6"/><rect x="221" y="153" width="8" height="4" rx="1"/><ellipse cx="225" cy="164" rx="9" ry="7"/><rect x="216" y="169" width="18" height="4" rx="2"/>
  </g>
  <!-- Title overlay -->
  <rect x="0" y="0" width="60" height="180" fill="#1B263B"/>
  <rect x="250" y="0" width="70" height="180" fill="#1B263B"/>
  <text x="16" y="95" font-family="Georgia, serif" font-size="11" fill="#CAF0F8" opacity="0.5" writing-mode="tb">PAWN PUSH</text>
  <text x="262" y="140" font-family="Georgia, serif" font-size="10" fill="#FFD166" opacity="0.7" writing-mode="tb">2 PLAYER</text>
</svg>
